#!/bin/sh
# Gives a dmenu prompt to mount unmounted local NAS shares for read/write.
# Requirements - "%wheel ALL=(ALL) NOPASSWD: ALL"
#
# FreeBSD has no cifs(5): SMB shares are mounted with mount_smbfs(8) from the
# base system, which takes //user@server/share rather than a -t cifs option.
#
# Browse for mDNS/DNS-SD services using the Avahi daemon...
srvname=$(avahi-browse _smb._tcp -t | awk '{print $4}' | dmenu -i -p "Which NAS?") || exit 1
notify-send "Searching for network shares..." "Please wait..."
# Choose share disk...
share=$(smbclient -L "$srvname" -N | grep Disk | awk '{print $1}' | dmenu -i -p "Mount which share?") || exit 1
# Format the share as mount_smbfs wants it...
share2mnt=//guest@"$srvname"/"$share"

sharemount() {
	mounted=$(mount -p | grep "$share") || ([ ! -d /mnt/"$share" ] && sudo mkdir /mnt/"$share")
	# -N skips the password prompt, -I resolves the server by mDNS name.
	[ -z "$mounted" ] && sudo mount_smbfs -N -I "$srvname".local \
		-u "$(id -u)" -g "$(id -g)" "$share2mnt" /mnt/"$share" &&
		notify-send "Netshare $share mounted" && exit 0
	notify-send "Netshare $share already mounted"; exit 1
}

sharemount
