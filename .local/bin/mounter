#!/bin/sh

# Mounts Android phones and USB drives (encrypted or not).
#
# The Linux version of this script reads lsblk and drives cryptsetup. Neither
# exists here: partitions come from gpart(8), the filesystem type from
# fstyp(8), and encryption is geli(8) rather than LUKS.

# Function for escaping cell-phone names.
escape(){ echo "$@" | iconv -cf UTF-8 -t ASCII//TRANSLIT | tr -d '[:punct:]' | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed "s/-\+/-/g;s/\(^-\|-\$\)//g" ;}

mounted="$(mount -p)"

# Check for phones.
phones="$(simple-mtpfs -l 2>/dev/null | sed "s/^/📱/")"
# If there are already mounted phones, remove them from the list of mountables.
phones="$(printf '%s\n' "$phones" | while read -r phone; do
	[ -n "$phone" ] || continue
	echo "$mounted" | grep -q "simple-mtpfs-$(escape "$phone")" || echo "$phone"
done)"

# Every partition gpart knows about, minus the ones that are part of the
# running system and the ones already mounted.
candidates="$(gpart show -p 2>/dev/null | awk '$1 != "=>" && $3 ~ /^[a-z]+[0-9]/ {
	if ($4 == "freebsd-boot" || $4 == "freebsd-swap" || $4 == "efi") next
	print $3, $5
}')"

drives="$(printf '%s\n' "$candidates" | while read -r part size; do
	[ -n "$part" ] || continue
	dev="/dev/$part"
	[ -e "$dev" ] || continue
	echo "$mounted" | grep -q "^$dev " && continue
	echo "$mounted" | grep -q "^$dev.eli " && continue
	# geli dump reads the metadata of a provider that is not attached yet,
	# which is the only way to spot an encrypted partition before opening it.
	if geli dump "$dev" >/dev/null 2>&1 && [ ! -e "$dev.eli" ]; then
		printf '🔒 %s %s\n' "$dev" "$size"
	else
		printf '💾 %s %s (%s)\n' "$dev" "$size" "$(fstyp "$dev" 2>/dev/null || echo unknown)"
	fi
done)"

# Add all to one variable. If no mountable drives found, exit.
alldrives="$(printf '%s\n%s\n' "$phones" "$drives" | sed "/^$/d;s/ *$//")"

# Quit the script if a sequential command fails.
set -e

test -n "$alldrives"

# Feed all found drives to dmenu and get user choice.
chosen="$(echo "$alldrives" | dmenu -p "Mount which drive?" -i)"

# Function for prompting user for a mountpoint.
getmount(){
	mp="$(find /mnt /media /mount /home -maxdepth 1 -type d 2>/dev/null | dmenu -i -p "Mount this drive where?")"
	test -n "$mp"
	if [ ! -d "$mp" ]; then
		mkdiryn=$(printf "No\nYes" | dmenu -i -p "$mp does not exist. Create it?")
		[ "$mkdiryn" = "Yes" ] && (mkdir -p "$mp" || sudo -A mkdir -p "$mp")
	fi
}

# Mount by filesystem type. The base system mounts msdosfs, ufs and ext2fs;
# NTFS and exFAT need their fusefs ports, since the in-kernel NTFS driver is
# read-only.
mountdev(){ # $1 device, $2 mountpoint
	case "$(fstyp "$1" 2>/dev/null)" in
	msdosfs) sudo -A mount -t msdosfs -o rw,-u="$(id -u)",-g="$(id -g)",-m=644,-M=755 "$1" "$2" ;;
	ntfs) sudo -A ntfs-3g -o permissions,uid="$(id -u)",gid="$(id -g)" "$1" "$2" ;;
	exfat) sudo -A mount.exfat-fuse -o uid="$(id -u)",gid="$(id -g)" "$1" "$2" ;;
	ext2fs) sudo -A mount -t ext2fs "$1" "$2" ;;
	ufs) sudo -A mount -t ufs "$1" "$2" ;;
	*) sudo -A mount "$1" "$2" ;;
	esac
}

attemptmount(){
		# Attempt to mount without a mountpoint, to see if drive is in fstab.
		sudo -A mount "$chosen" || return 1
		notify-send "💾Drive Mounted." "$chosen mounted."
		exit
}

case "$chosen" in
	💾*)
		chosen="$(echo "$chosen" | awk '{print $2}')"
		attemptmount || getmount
		mountdev "$chosen" "$mp"
		notify-send "💾Drive Mounted." "$chosen mounted to $mp."
		;;

	🔒*)
		chosen="$(echo "$chosen" | awk '{print $2}')"
		# Attach in a terminal window so geli can ask for the passphrase.
		${TERMINAL:-st} -n floatterm -g 60x1 -e sudo -A geli attach "$chosen"

		# Check that it is now attached.
		test -e "$chosen.eli"

		getmount
		mountdev "$chosen.eli" "$mp"
		notify-send "🔓Decrypted drive Mounted." "$chosen decrypted and mounted to $mp."
		;;

	📱*)
		notify-send "❗Note" "Remember to allow file access on your phone now."
		getmount
		number="$(echo "$chosen" | sed 's/^📱//;s/:.*//')"
		sudo -A simple-mtpfs -o allow_other -o fsname="simple-mtpfs-$(escape "$chosen")" --device "$number" "$mp"
		notify-send "🤖 Android Mounted." "Android device mounted to $mp."
		;;
esac
