#!/bin/sh

# Unmount USB drives or Android phones. Replaces the older `dmenuumount`. Fewer
# prompts, and also detaches geli devices that are unmounted.
#
# mount -p prints the fstab-style table this needs; there is no /etc/mtab and
# no lsblk here.

set -e

mountlist="$(mount -p)"

mounteddroids="$(echo "$mountlist" | awk '$1 ~ /simple-mtpfs/ {print "📱" $2}')"

# Anything mounted from a real device outside the system's own filesystems.
mounteddrives="$(echo "$mountlist" | awk '$1 ~ /^\/dev\// &&
	$2 != "/" && $2 != "/boot" && $2 != "/home" && $2 != "/usr" && $2 != "/var" &&
	$2 != "/tmp" && $3 != "swap" {printf "💾%s (%s)\n", $2, $1}')"

allunmountable="$(echo "$mounteddroids
$mounteddrives" | sed "/^$/d;s/ *$//")"
test -n "$allunmountable"

chosen="$(echo "$allunmountable" | dmenu -i -p "Unmount which drive?")"
chosen="${chosen%% *}"
test -n "$chosen"

mountpoint="/${chosen#*/}"
device="$(echo "$mountlist" | awk -v mp="$mountpoint" '$2 == mp {print $1; exit}')"

sudo -A umount "$mountpoint"
notify-send "Device unmounted." "$chosen has been unmounted."

# Close the chosen drive if it was a geli provider.
case "$device" in
*.eli)
	sudo -A geli detach "${device%.eli}"
	notify-send "🔒Device dencryption closed." "Drive is now securely locked again."
	;;
esac
