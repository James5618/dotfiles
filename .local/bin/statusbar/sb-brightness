#!/bin/sh

# FreeBSD exposes the panel backlight through backlight(8) rather than
# /sys/class/backlight; it already reports a percentage.
brightness_per="$(backlight 2>/dev/null | sed -n 's/^brightness: *//p')"
[ -n "$brightness_per" ] || exit 0

case $BLOCK_BUTTON in
    1) 
        ;;
    3) 
        notify-send "💡 Brightness module" "\- Shows current brightness level ☀️." 
        ;;
    6) 
        daemon -f "$TERMINAL" -e "$EDITOR" "$0"
        ;;
esac

echo "💡 ${brightness_per}%"
