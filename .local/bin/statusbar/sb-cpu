#!/bin/sh

case $BLOCK_BUTTON in
	1) notify-send "🖥 CPU hogs" "$(ps -axo comm= -o pcpu= | awk '{cmd[$1]+=$2} END {for (i in cmd) print i, cmd[i]}' | sort -nrk2  | head)\\n(100% per core)" ;;
	2) daemon -f "$TERMINAL" -e htop ;;
	3) notify-send "🖥 CPU module " "\- Shows CPU temperature.
- Click to show intensive processes.
- Middle click to open htop." ;;
	6) daemon -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# lm_sensors does not exist here: the temperature comes from the coretemp(4) or
# amdtemp(4) sysctl, which prints e.g. "46.0C". Load the module in
# /etc/rc.conf (kld_list="coretemp") or nothing is published.
sysctl -n dev.cpu.0.temperature 2>/dev/null | sed 's/^/🌡/'
