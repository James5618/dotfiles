#!/bin/sh

# Originally by Andr3as07 <https://github.com/Andr3as07>
# Some changes by Luke
# Rebuild by Tenyun

# This block displays the number running background tasks.  Requires the task
# spooler from sysutils/ts.
#
# It has to be called by path: the base system has a ts(1) of its own - a
# timestamp filter - and /usr/bin comes before /usr/local/bin in the default
# PATH, so a bare `ts` is the wrong program entirely.
tsp="/usr/local/bin/ts"
[ -x "$tsp" ] || tsp="$(command -v tsp)" || exit 0

num=$("$tsp" -l | awk -v numr=0 -v numq=0 '{if (/running/)numr++; if (/queued/)numq++} END{print numr+numq"("numq")"}')

# Handle mouse clicks
case $BLOCK_BUTTON in
	1) daemon -f "$TERMINAL" -e "$tsp" -l ;;
	3) notify-send "Tasks module" ": number of running/queued background tasks
- Left click opens ts" ;; # Right click
	6) daemon -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

[ "$num" != "0(0)" ] &&
	echo " $num"
