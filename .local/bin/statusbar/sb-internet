#!/bin/sh

# Show wifi  and percent strength or  if none.
# Show  if connected to ethernet or ✗ if none.
# Show  if a vpn connection is active

case $BLOCK_BUTTON in
	1) if command -v wifimgr >/dev/null 2>&1; then daemon -f "$TERMINAL" -e wifimgr
		else notify-send " Interfaces" "$(ifconfig -u | grep -E "^[a-z]|inet |status:")"
		fi; pkill -69 "${STATUSBAR:-dwmblocks}" ;;
	3) notify-send " Internet module" "\- Click to connect
✗: wifi disabled
: no wifi connection
: wifi connection with quality
✗: no ethernet
: ethernet working
: vpn is active
" ;;
	6) daemon -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# There is no /sys here: everything comes from ifconfig(8). FreeBSD wireless
# lives on cloned wlanN devices rather than the driver's own interface.
wlan="$(ifconfig -l | tr " " "\n" | grep -m1 "^wlan")"
if [ -n "$wlan" ]; then
	case "$(ifconfig "$wlan" 2>/dev/null | sed -n "s/.*status: //p")" in
	associated)
		# RSSI from the associated AP, in dB above the noise floor, scaled
		# the same way the Linux version scales the /proc link quality.
		wifiicon="$(ifconfig "$wlan" list sta 2>/dev/null | awk -v icon="" 'NR==2 { printf "%s %d%% ", icon, int($5 * 100 / 70) }')"
		[ -n "$wifiicon" ] || wifiicon=" " ;;
	*) wifiicon="✗ " ;;
	esac
fi

# Ethernet. Interface names are driver-specific here (em0, re0, igb0, vtnet0
# and so on), so take any link that is up and is not loopback, wireless or a
# tunnel.
ethericon="✗"
for iface in $(ifconfig -l); do
	case "$iface" in
	lo* | wlan* | tun* | tap* | bridge* | pflog* | pfsync* | vm-*) continue ;;
	esac
	ifconfig "$iface" 2>/dev/null | grep -q "status: active" && {
		ethericon=""
		break
	}
done

# TUN/TAP (a VPN, or a jail bridge that has an address).
ifconfig -u 2>/dev/null | grep -q "^tun[0-9]" &&
	tunicon=" "

printf "%s%s%s\n" "$wifiicon" "$ethericon" "$tunicon"
