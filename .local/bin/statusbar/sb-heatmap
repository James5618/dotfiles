#!/bin/sh

# Temperature heatmap for Europe.
#
# Shows the temperature as a smooth field with the reading printed over each
# town, the way a TV forecast map does, and the time that reading was taken
# along the top. Set metric=max below for today's high instead of now, which
# is the number that matters for a heatwave. Data is Open-Meteo, which is free
# and needs no API key, and takes a whole grid of points in one request. The
# map and tile maths are shared with sb-doppler.
#
# There is no free temperature tile layer to draw the way sb-doppler draws
# RainViewer's radar - OpenWeatherMap and Windy both want an API key - so the
# field is interpolated here from a grid of point readings.
#
# Needs: curl, ImageMagick, nsxiv or mpv.

# shellcheck source=./euromap
. "$(dirname "$0")/euromap"

mapname=" Heatmap"
secs=900            # readings step every 15 minutes, so match that
defaultloc="UK"
# "now" is the reading on the ground this quarter hour, which is what a
# forecast map shows; "max" is today's high, the heatwave number. Either way
# the time the reading was taken is printed on the map.
metric=now
tmid=20             # neutral midpoint - neither cold nor hot
autoscale=1         # fit the ends to the day, keeping tmid in the middle
tmin=0              # used when autoscale is 0
tmax=40
opacity=55          # percent, so the map still reads underneath
# Open-Meteo counts each location as an API call against a 600/minute free
# tier budget, so a dense grid burns it fast: three 400-point requests in a
# row already returns 429. The field is heavily blurred on the way to the
# screen, so a coarser grid costs almost nothing visually.
maxpoints=225

cache="${XDG_CACHE_HOME:-$HOME/.cache}"
heatloc="$cache/heatmap-region"
heatmap="$cache/heatmap.png"
deg=$(printf '\302\260')

# Diverging blue <-> red through a neutral grey: temperature has a real
# midpoint, so what is encoded is which side of mild a place sits on, not bare
# magnitude. Deliberately not a rainbow.
# stop|r|g|b   (stop is 0..1 across the low..high ends of the scale)
ramp="0.00|13|54|107
0.25|57|135|229
0.45|205|226|251
0.50|240|239|236
0.55|247|206|199
0.75|227|73|72
1.00|125|29|29"

