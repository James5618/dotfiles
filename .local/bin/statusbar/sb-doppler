#!/bin/sh

# Show a rain RADAR for a location in Europe. Defaults to the UK.
#
# Europe has no equivalent of NOAA's ready-made ridge loops: almost no national
# met service publishes a plain radar image at a stable URL. The two that do,
# Germany's DWD and the Netherlands' KNMI, are kept as high detail options. For
# everywhere else - including the UK, which publishes nothing usable - frames
# come from RainViewer's public tile API, which needs no key, composited over an
# OpenStreetMap basemap so the rain has some geography under it.
#
# Needs: curl, ImageMagick, mpv.

# shellcheck source=./sb-euromap
. "$(dirname "$0")/sb-euromap"

mapname=" Doppler RADAR"
secs=600        # reuse the cached animation if it is newer than this
frames=6        # RainViewer frames per animation
delay=40        # hundredths of a second between frames
defaultloc="UK"

cache="${XDG_CACHE_HOME:-$HOME/.cache}"
radarloc="$cache/radar"
doppler="$cache/doppler.gif"

# The shared geographic regions all use RainViewer. These are the extras: the
# two national services that publish a ready-made animation of their own.
#   DWD  = Deutscher Wetterdienst film, field: state code
#   KNMI = Koninklijk Nederlands Meteorologisch Instituut map, no fields
national="NL: Netherlands (KNMI)|KNMI|
DE: Baden-Wuerttemberg (DWD)|DWD|baw
DE: Bavaria (DWD)|DWD|bay
DE: Berlin and Brandenburg (DWD)|DWD|bbb
DE: Hesse (DWD)|DWD|hes
DE: Mecklenburg-W Pomerania (DWD)|DWD|mvp
DE: Lower Saxony and Bremen (DWD)|DWD|nib
DE: North Rhine-Westphalia (DWD)|DWD|nrw
DE: Rhineland-Palatinate (DWD)|DWD|rps
DE: Saxony (DWD)|DWD|sac
DE: Saxony-Anhalt (DWD)|DWD|saa
DE: Schleswig-Holstein and Hamburg (DWD)|DWD|shh
DE: Thuringia (DWD)|DWD|thu"

menu() { printf '%s\n' "$mapregions" | cut -d'|' -f1; printf '%s\n' "$national" | cut -d'|' -f1 ;}
natlookup() { printf '%s\n' "$national" | grep -m1 "^$1|" ;}

pickloc() {
	chosen="$(menu | dmenu -r -i -l 20 -p "Select a radar to use as default:")"
	# Ensure user did not escape.
	[ -z "$chosen" ] && return 1
	{ maplookup "$chosen" >/dev/null || natlookup "$chosen" >/dev/null ;} || return 1
	printf '%s\n' "$chosen" > "$radarloc"
}

getrainviewer() {
	zoom="$1"
	maptiles "$1" "$2" "$3" "$4" "$5"

	json=$(curl -sfL --max-time 20 "https://api.rainviewer.com/public/weather-maps.json") ||
		{ mapfail "Could not reach api.rainviewer.com."; return 1 ;}
	host=$(printf '%s' "$json" | grep -o '"host":"[^"]*"' | cut -d'"' -f4)
	paths=$(printf '%s' "$json" | grep -o '"path":"[^"]*"' | cut -d'"' -f4 | tail -n "$frames")
	{ [ -n "$host" ] && [ -n "$paths" ] ;} ||
		{ mapfail "RainViewer returned no radar frames."; return 1 ;}

	mkdir -p "$mapcache"
	rm -f "$mapcache"/frame-*.png
	mapbasemap "$zoom" ||
		{ mapfail "Could not fetch map tiles from tile.openstreetmap.org."; return 1 ;}

	i=0
	for p in $paths; do
		i=$((i + 1))
		rm -f "$mapcache"/rv-*.png
		if mapgrid "$host$p/256/$zoom/{X}/{Y}/4/1_1.png" "$mapcache/rain.png" "rv"; then
			im composite "$mapcache/rain.png" "$mapbase" \
				"$(printf '%s/frame-%02d.png' "$mapcache" "$i")"
		fi
	done
	[ -n "$(ls "$mapcache"/frame-*.png 2>/dev/null)" ] ||
		{ mapfail "Got the map but built no radar frame. Is ImageMagick installed?"; return 1 ;}
	im convert -delay "$delay" -loop 0 "$mapcache"/frame-*.png "$doppler" ||
		{ mapfail "ImageMagick could not assemble the animation."; return 1 ;}
}

# Settle which region is being drawn and from which source. Separate from
# getdoppler because the cache identity needs it before deciding to build.
resolve() {
	region=$(cat "$radarloc" 2>/dev/null)
	[ -z "$region" ] && region="$defaultloc"
	entry=$(maplookup "$region"); src=RV
	if [ -z "$entry" ]; then
		entry=$(natlookup "$region")
		src=$(printf '%s' "$entry" | cut -d'|' -f2)
	fi
	# A name that is not in either list - a hand edited file, or a region that
	# was renamed out from under it - falls back to the default rather than
	# leaving nothing to show.
	if [ -z "$entry" ]; then
		region="$defaultloc"
		entry=$(maplookup "$region"); src=RV
	fi
	[ -n "$entry" ]
}

getdoppler() {
	notify-send "$mapname" "Pulling the most recent radar for $region."
	case "$src" in
		RV)
			haveim ||
				{ mapfail "ImageMagick is not installed, so the $region radar cannot be built. On Arch: sudo pacman -S imagemagick"; return 1 ;}
			# shellcheck disable=SC2046
			getrainviewer $(printf '%s' "$entry" | cut -d'|' -f2-6 | tr '|' ' ') ;;
		DWD)
			state=$(printf '%s' "$entry" | cut -d'|' -f3)
			curl -sfL --max-time 30 -o "$doppler" \
				"https://www.dwd.de/DWD/wetter/radar/radfilm_${state}_akt.gif" ||
				{ mapfail "Could not fetch the DWD film for $region."; return 1 ;} ;;
		KNMI)
			curl -sfL --max-time 30 -o "$doppler" \
				"https://cdn.knmi.nl/knmi/map/general/weather-map.gif" ||
				{ mapfail "Could not fetch the KNMI map."; return 1 ;} ;;
	esac
	mapmark "$doppler" "$(dopid)"
}

showdoppler() { setsid -f mpv --no-osc --loop=inf --no-terminal "$doppler" ;}

# Everything that changes the animation, plus the script timestamps via mapid,
# so an updated copy rebuilds instead of serving the previous version's output.
dopid() { mapid "$region" "$src" "$frames" "$delay" ;}

case $BLOCK_BUTTON in
	1) resolve || { mapfail "No region to draw."; exit 1 ;}
	mapfresh "$doppler" "$secs" "$(dopid)" || getdoppler
	# A getdoppler that already explained itself leaves no file; only warn
	# here if nothing was produced and nothing was said.
	if [ -s "$doppler" ]; then showdoppler; else mapfail "No radar image to show."; fi ;;
	2) pickloc && resolve && getdoppler && [ -s "$doppler" ] && showdoppler ;;
	3) notify-send " Doppler RADAR module" "\- Left click for the local rain RADAR.
- Middle click to change RADAR location.
Defaults to the $defaultloc. After $secs seconds, a left click refreshes it too." ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# U+F279 (nf-fa-map), written as bytes so no editor or locale can mangle it.
# Font Awesome's BMP range only - plane 15 glyphs exist solely in the patched
# Nerd Font and box out anywhere it is missing.
printf '\357\211\271\n'
