#!/bin/sh

# transmission-remote is in the transmission-utils package here, not
# transmission-cli. The bar runs this every 20 seconds, so say nothing at all
# rather than printing an error onto the console that many times.
command -v transmission-remote >/dev/null 2>&1 || exit 0

# The daemon may simply not be running; that is not worth an error every
# 20 seconds on whatever tty dwm was started from.
transmission-remote -l 2>/dev/null | grep % |
	sed " # The letters are for sorting and will not appear.
	s/.*Stopped.*/A /;
	s/.*Seeding.*/Z /;
	s/.*100%.*/N /;
	s/.*Idle.*/B /;
	s/.*Uploading.*/L /;
	s/.*%.*/M /" |
		sort -h | uniq -c | awk '{print $3 " " $1}' | paste -sd ' ' -

case $BLOCK_BUTTON in
	1) daemon -f "$TERMINAL" -e stig ;;
	2) td-toggle ;;
	3) notify-send " Torrent module" "\- Left click to open stig.
- Middle click to toggle transmission.
- Shift click to edit script.
Module shows number of torrents:
: paused
: idle (seeds needed)
: uploading (unfinished)
: downloading
: done
: done and seeding" ;;
	6) daemon -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac
