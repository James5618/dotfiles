#!/bin/sh

# Displays the number of upgradable packages.
# For this to work, have `pkg update` run in the background as a cronjob every
# so often as root. This script then only reads the catalogue it left behind,
# so it never blocks the bar on the network. When clicked, it runs the upgrade.
#
# To refresh the module the moment an upgrade finishes, add this to
# /usr/local/etc/pkg.conf so pkg(8) signals the bar itself:
#
# POST_INSTALL_HOOK = "/bin/pkill -73 dwmblocks || true";

case $BLOCK_BUTTON in
	1) daemon -f "$TERMINAL" -e sb-popupgrade ;;
	2) notify-send "$(pkg version -vRL=)" ;;
	3) notify-send " Upgrade module" ": number of upgradable packages
- Left click to upgrade packages
- Middle click to show upgradable packages" ;;
	6) daemon -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

pkg version -vRL= 2>/dev/null | grep -c . | sed "s/^/ /;s/^ 0$//g"
