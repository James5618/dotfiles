#!/bin/sh

# Syncs repositories and downloads updates, meant to be run as a cronjob.

notify-send "📦 Repository Sync" "Checking for package updates..."

# -F fetches the packages without installing them, which is the pkg(8)
# equivalent of pacman -Syyuw: the upgrade itself stays a deliberate act.
sudo pkg update -f >/dev/null 2>&1 && sudo pkg upgrade -Fy >/dev/null 2>&1 ||
	notify-send "Error downloading updates.

Check your internet connection, whether another pkg process holds the lock, or
run the update by hand to see the errors."
pkill -73 "${STATUSBAR:-dwmblocks}"

if pkg version -vRL= 2>/dev/null | grep -q .
then
	notify-send "🎁 Repository Sync" "Updates available. Click statusbar icon (📦) for update."
else
	notify-send "📦 Repository Sync"  "Sync complete. No new packages for update."
fi
