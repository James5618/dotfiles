#!/bin/sh

# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit like a Chad, this file will also be sourced.

xrandr --dpi 96		# Set DPI. User may want to use a larger number for larger screens.
xsetroot -cursor_name left_ptr	# Root cursor; without this the pointer is invisible until an app sets one.
setbg &			# set the background with the `setbg` script
xrdb ${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources & xrdbpid=$!	# Load Xresources colors/settings on startup

autostart="mpd dunst unclutter pipewire remapd"

for program in $autostart; do
	pidof -sx "$program" || "$program" &
done >/dev/null 2>&1

# picom is started separately because the backend has to suit the hardware.
# glx rounds corners far more cleanly, but under a hypervisor OpenGL is
# software-rendered: it survives startup (so waiting for picom to exit is not
# enough) and then loses its context when the screen wakes from DPMS, after
# which picom never paints again and the desktop looks frozen even though X
# and dwm are still running. Use xrender there, and stop blanking altogether
# since a virtual screen has no power to save.
if ! pidof -sx picom >/dev/null 2>&1; then
	case "$(systemd-detect-virt 2>/dev/null || grep -io hypervisor /proc/cpuinfo | head -1)" in
	"" | none) { picom || picom --backend xrender ;} >/dev/null 2>&1 & ;;
	*) xset s off -dpms; picom --backend xrender >/dev/null 2>&1 & ;;
	esac
fi

# Ensure that xrdb has finished running before moving on to start the WM/DE.
[ -n "$xrdbpid" ] && wait "$xrdbpid"
